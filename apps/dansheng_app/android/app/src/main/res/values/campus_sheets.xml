<resources>
    <!-- Warm paper & teal Material 3 palette for campus sheets -->
    <color name="campus_teal">#006A72</color>
    <color name="campus_teal_dark">#4DD0E1</color>
    <color name="campus_teal_container">#CCE8E8</color>
    <color name="campus_teal_container_dark">#004F55</color>
    <color name="campus_teal_on_container">#002022</color>
    <color name="campus_teal_on_container_dark">#B2EBF2</color>

    <color name="campus_paper_light">#FAF8F5</color>
    <color name="campus_paper_card_light">#F3EFEA</color>
    <color name="campus_paper_dark">#1A1C1E</color>
    <color name="campus_paper_card_dark">#242729</color>

    <color name="campus_text_primary_light">#191C1D</color>
    <color name="campus_text_secondary_light">#404848</color>
    <color name="campus_text_primary_dark">#E1E3E3</color>
    <color name="campus_text_secondary_dark">#BFC8C7</color>

    <color name="campus_divider_light">#DDE4E3</color>
    <color name="campus_divider_dark">#3F4948</color>

    <color name="campus_status_off_bg">#F2ECE9</color>
    <color name="campus_status_off_text">#705D56</color>
    <color name="campus_status_official_bg">#E6F4EA</color>
    <color name="campus_status_official_text">#137333</color>
    <color name="campus_status_unverified_bg">#FEF7E0</color>
    <color name="campus_status_unverified_text">#945800</color>

    <dimen name="campus_sheet_corner_radius">24dp</dimen>
    <dimen name="campus_sheet_drag_handle_width">36dp</dimen>
    <dimen name="campus_sheet_drag_handle_height">4dp</dimen>
    <dimen name="campus_sheet_horizontal_padding">20dp</dimen>

    <!-- Base DayNight Theme for Campus Bottom Sheets -->
    <style name="Theme.Dansheng.BottomSheetDialog" parent="Theme.Material3.DayNight.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Dansheng.BottomSheet</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="colorPrimary">@color/campus_teal</item>
    </style>

    <style name="Widget.Dansheng.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="shapeAppearance">@style/ShapeAppearance.Dansheng.BottomSheet</item>
    </style>

    <style name="ShapeAppearance.Dansheng.BottomSheet" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSizeTopLeft">@dimen/campus_sheet_corner_radius</item>
        <item name="cornerSizeTopRight">@dimen/campus_sheet_corner_radius</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
    <style name="Theme.Dansheng.SheetContent" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/campus_teal</item>
    </style>
</resources>
